# Copy this file to .env and replace values for your local environment.
# Never put real credentials in this file or commit .env.

NODE_ENV=development
PORT=3000

# Public application identifier (not a secret; VITE_* values may reach the browser bundle).
VITE_APP_ID=

# Generate a strong, unique secret. Do not use this placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret

# Example format only; use a development database and your actual credentials locally.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# OAuth provider configuration (needed for OAuth sign-in).
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Manus/Forge integrations (only needed by features that use these services).
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
